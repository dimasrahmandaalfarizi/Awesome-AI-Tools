# ─── Awesome AI Tools — Production Environment Variables ──────────────────────
# Copy this file to .env.local for local development or configure in your
# hosting provider dashboard (Vercel, Railway, Coolify, VPS, etc.)

# Public App URL (used for canonical SEO, sitemaps, OpenGraph metadata)
NEXT_PUBLIC_APP_URL=https://awesome-ai-tools.dev

# ─── AI Cloud Provider Keys (Optional / Fallback Cascade) ────────────────────
# Order of priority: Groq -> OpenRouter -> DeepSeek -> Gemini -> OpenAI -> Local Ollama

# GROQ (High speed free tier - https://console.groq.com)
GROQ_API_KEY=

# OPENROUTER (Unified gateway with free models - https://openrouter.ai)
OPENROUTER_API_KEY=

# DEEPSEEK (Cost-efficient reasoning models - https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# GOOGLE GEMINI (Multimodal AI models - https://aistudio.google.com)
GEMINI_API_KEY=

# OPENAI (GPT-4o, GPT-4o-mini - https://platform.openai.com)
OPENAI_API_KEY=
